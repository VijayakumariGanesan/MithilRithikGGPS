<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Senior Healthcare & Tele-Consultation App</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              blue: '#1E40AF',
              lightBlue: '#EFF6FF',
              red: '#DC2626',
              green: '#15803D',
              amber: '#D97706'
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      font-size: 18px; /* High legibility for seniors */
      background-color: #F3F4F6;
    }
    .btn-senior {
      min-height: 52px;
      font-weight: 700;
    }
    .high-contrast-card {
      border: 2px solid #E5E7EB;
    }
  </style>
</head>
<body class="text-gray-900 pb-20">

  <!-- Header Banner -->
  <header class="bg-brand-blue text-white p-4 sticky top-0 z-50 shadow-md">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <i class="fa-solid font-bold text-3xl fa-heart-pulse text-red-400"></i>
        <div>
          <h1 class="text-xl font-bold leading-tight" id="app-title">Senior Care</h1>
          <p class="text-xs text-blue-100" id="app-subtitle">Health & Tele-Consultation</p>
        </div>
      </div>
      <!-- Language Switcher -->
      <button onclick="toggleLanguage()" class="bg-white text-brand-blue font-bold px-3 py-1.5 rounded-lg shadow text-sm hover:bg-gray-100 transition">
        <i class="fa-solid fa-language mr-1"></i>
        <span id="lang-toggle-text">தமிழ்</span>
      </button>
    </div>
  </header>

  <!-- SOS Emergency Banner -->
  <div class="bg-red-600 text-white p-3 shadow-lg">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <i class="fa-solid fa-truck-medical text-2xl animate-bounce"></i>
        <div>
          <p class="font-bold text-sm" id="sos-title">Medical Emergency?</p>
          <p class="text-xs" id="sos-desc">Instant 108 Ambulance Request</p>
        </div>
      </div>
      <button onclick="triggerSOS()" class="bg-white text-red-700 font-extrabold px-4 py-2 rounded-xl shadow border-2 border-red-200 text-sm hover:bg-red-50 active:scale-95 transition">
        <i class="fa-solid fa-phone-flip mr-1"></i> CALL 108
      </button>
    </div>
  </div>

  <!-- Main Container -->
  <main class="max-w-md mx-auto p-4 space-y-6">

    <!-- Section 1: Senior Patient Details -->
    <section class="bg-white p-5 rounded-2xl shadow high-contrast-card">
      <div class="flex items-center space-x-2 border-b pb-3 mb-4">
        <i class="fa-solid fa-id-card text-brand-blue text-xl"></i>
        <h2 class="font-bold text-lg" id="patient-info-heading">Patient Basic Details</h2>
      </div>
      <form id="patient-form" onsubmit="savePatientInfo(event)" class="space-y-4">
        <div>
          <label class="block font-semibold text-sm mb-1" id="lbl-name">Full Name / பெயர்</label>
          <input type="text" id="patient-name" required placeholder="e.g. Ramasamy M" class="w-full p-3 border-2 border-gray-300 rounded-xl text-base focus:border-brand-blue outline-none">
        </div>
        <div>
          <label class="block font-semibold text-sm mb-1" id="lbl-mobile">Mobile Number / கைபேசி எண்</label>
          <input type="tel" id="patient-mobile" required pattern="[0-9]{10}" placeholder="10-digit mobile number" class="w-full p-3 border-2 border-gray-300 rounded-xl text-base focus:border-brand-blue outline-none">
        </div>
        <div>
          <label class="block font-semibold text-sm mb-1" id="lbl-aadhar">Aadhaar Card / ஆதார் எண்</label>
          <input type="text" id="patient-aadhar" required pattern="[0-9]{12}" placeholder="12-digit Aadhaar number" class="w-full p-3 border-2 border-gray-300 rounded-xl text-base focus:border-brand-blue outline-none">
          <p class="text-xs text-gray-500 mt-1" id="aadhar-note">Stored securely for emergency registration</p>
        </div>
        <button type="submit" class="w-full bg-brand-blue text-white btn-senior rounded-xl shadow hover:bg-blue-800 transition">
          <i class="fa-solid fa-floppy-disk mr-2"></i><span id="btn-save-patient">Save Patient Profile</span>
        </button>
      </form>
    </section>

    <!-- Section 2: Diseases, Symptoms, Remedies & Medicines -->
    <section class="bg-white p-5 rounded-2xl shadow high-contrast-card">
      <div class="flex items-center justify-between border-b pb-3 mb-4">
        <div class="flex items-center space-x-2">
          <i class="fa-solid fa-notes-medical text-brand-blue text-xl"></i>
          <h2 class="font-bold text-lg" id="symptoms-heading">Symptoms & Remedies</h2>
        </div>
      </div>

      <!-- Filter Buttons -->
      <div class="flex space-x-2 mb-4">
        <button onclick="filterDiseases('all')" id="tab-all" class="flex-1 py-2 text-xs font-bold rounded-lg bg-brand-blue text-white">All</button>
        <button onclick="filterDiseases('infectious')" id="tab-inf" class="flex-1 py-2 text-xs font-bold rounded-lg bg-gray-200 text-gray-800">Infectious</button>
        <button onclick="filterDiseases('chronic')" id="tab-chr" class="flex-1 py-2 text-xs font-bold rounded-lg bg-gray-200 text-gray-800">Chronic (NCD)</button>
      </div>

      <!-- Disease Search Box -->
      <div class="mb-4">
        <input type="text" id="disease-search" oninput="renderDiseases()" placeholder="Search symptom / நோய் தேடுக..." class="w-full p-2.5 border-2 border-gray-300 rounded-xl text-sm outline-none focus:border-brand-blue">
      </div>

      <!-- Disease Cards List -->
      <div id="disease-list" class="space-y-4">
        <!-- Rendered dynamically -->
      </div>
    </section>

    <!-- Section 3: Nearby Doctor Contacts & Tele-Appointment -->
    <section class="bg-white p-5 rounded-2xl shadow high-contrast-card">
      <div class="flex items-center space-x-2 border-b pb-3 mb-4">
        <i class="fa-solid fa-user-doctor text-brand-blue text-xl"></i>
        <h2 class="font-bold text-lg" id="doctor-heading">Nearby Doctors & Tele-Consult</h2>
      </div>

      <!-- Doctor Cards -->
      <div class="space-y-3 mb-6">
        <!-- Doctor 1 -->
        <div class="p-4 border-2 border-blue-100 bg-blue-50/50 rounded-xl flex items-center justify-between">
          <div>
            <h3 class="font-bold text-base text-brand-blue">Dr. S Satheesh Kumar</h3>
            <p class="text-xs text-gray-600">General Physician & Senior Specialist</p>
            <p class="text-xs text-brand-blue font-semibold mt-1"><i class="fa-solid fa-phone mr-1"></i>9486817727</p>
          </div>
          <a href="tel:9486817727" class="bg-brand-green text-white px-3 py-2 rounded-xl text-sm font-bold flex items-center space-x-1 hover:bg-green-800">
            <i class="fa-solid fa-phone"></i>
            <span id="btn-call-1">Call</span>
          </a>
        </div>

        <!-- Doctor 2 -->
        <div class="p-4 border-2 border-blue-100 bg-blue-50/50 rounded-xl flex items-center justify-between">
          <div>
            <h3 class="font-bold text-base text-brand-blue">Dr. G Vijayakumari</h3>
            <p class="text-xs text-gray-600">Senior Care Specialist</p>
            <p class="text-xs text-brand-blue font-semibold mt-1"><i class="fa-solid fa-phone mr-1"></i>9487667893</p>
          </div>
          <a href="tel:9487667893" class="bg-brand-green text-white px-3 py-2 rounded-xl text-sm font-bold flex items-center space-x-1 hover:bg-green-800">
            <i class="fa-solid fa-phone"></i>
            <span id="btn-call-2">Call</span>
          </a>
        </div>
      </div>

      <!-- Phone Appointment Form for Non-Communicable Diseases -->
      <div class="border-t pt-4">
        <h3 class="font-bold text-sm mb-3 text-gray-800" id="appoint-title">Book Phone Consultation (NCD / Chronic)</h3>
        <form onsubmit="bookAppointment(event)" class="space-y-3">
          <select id="appoint-doctor" required class="w-full p-3 border-2 border-gray-300 rounded-xl text-sm">
            <option value="">Select Doctor / மருத்துவர் தேர்ந்தெடுக்கவும்</option>
            <option value="Dr S Satheesh Kumar">Dr. S Satheesh Kumar (9486817727)</option>
            <option value="Dr G Vijayakumari">Dr. G Vijayakumari (9487667893)</option>
          </select>
          <input type="date" id="appoint-date" required class="w-full p-3 border-2 border-gray-300 rounded-xl text-sm">
          <textarea id="appoint-reason" rows="2" placeholder="Mention health concern (e.g. High BP, Joint Pain)" class="w-full p-3 border-2 border-gray-300 rounded-xl text-sm"></textarea>
          <button type="submit" class="w-full bg-brand-amber text-white btn-senior rounded-xl font-bold shadow hover:bg-amber-700 transition">
            <i class="fa-solid fa-calendar-check mr-2"></i><span id="btn-book">Confirm Phone Appointment</span>
          </button>
        </form>
      </div>
    </section>

    <!-- Section 4: Competition Prize Special Feature - Audio Voice Reader -->
    <section class="bg-gradient-to-r from-blue-900 to-indigo-900 text-white p-5 rounded-2xl shadow">
      <div class="flex items-center space-x-2 mb-2">
        <i class="fa-solid fa-award text-yellow-400 text-2xl"></i>
        <h2 class="font-bold text-base" id="expo-title">Expo Feature: Voice Healthcare Assistant</h2>
      </div>
      <p class="text-xs text-blue-200 mb-3" id="expo-desc">Designed for visually challenged elderly users. Tap below to speak out emergency instructions.</p>
      <button onclick="speakInstructions()" class="w-full bg-yellow-400 text-gray-900 font-extrabold py-3 rounded-xl shadow flex items-center justify-center space-x-2 hover:bg-yellow-300">
        <i class="fa-solid fa-volume-high text-lg"></i>
        <span id="btn-voice">Read Out Emergency Instructions</span>
      </button>
    </section>

  </main>

