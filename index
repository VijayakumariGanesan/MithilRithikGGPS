    // Initialize UI on Load
    window.onload = function() {
      loadSavedPatient();
      renderDiseases();
    };

    // Toggle Language
    function toggleLanguage() {
      currentLang = (currentLang === 'en') ? 'ta' : 'en';
      document.getElementById('lang-toggle-text').innerText = (currentLang === 'en') ? 'தமிழ்' : 'English';
      
      const text = contentData[currentLang];
      document.getElementById('app-title').innerText = text.appTitle;
      document.getElementById('app-subtitle').innerText = text.appSubtitle;
      document.getElementById('sos-title').innerText = text.sosTitle;
      document.getElementById('sos-desc').innerText = text.sosDesc;
      document.getElementById('patient-info-heading').innerText = text.patientHeading;
      document.getElementById('lbl-name').innerText = text.lblName;
      document.getElementById('lbl-mobile').innerText = text.lblMobile;
      document.getElementById('lbl-aadhar').innerText = text.lblAadhar;
      document.getElementById('aadhar-note').innerText = text.aadharNote;
      document.getElementById('btn-save-patient').innerText = text.btnSave;
      document.getElementById('symptoms-heading').innerText = text.symptomsHeading;
      document.getElementById('doctor-heading').innerText = text.doctorHeading;
      document.getElementById('btn-call-1').innerText = text.btnCall;
      document.getElementById('btn-call-2').innerText = text.btnCall;
      document.getElementById('appoint-title').innerText = text.appointTitle;
      document.getElementById('btn-book').innerText = text.btnBook;
      document.getElementById('expo-title').innerText = text.expoTitle;
      document.getElementById('expo-desc').innerText = text.expoDesc;
      document.getElementById('btn-voice').innerText = text.btnVoice;

      renderDiseases();
    }

    // Filter Diseases
    function filterDiseases(cat) {
      activeFilter = cat;
      document.getElementById('tab-all').className = cat === 'all' ? 'flex-1 py-2 text-xs font-bold rounded-lg bg-brand-blue text-white' : 'flex-1 py-2 text-xs font-bold rounded-lg bg-gray-200 text-gray-800';
      document.getElementById('tab-inf').className = cat === 'infectious' ? 'flex-1 py-2 text-xs font-bold rounded-lg bg-brand-blue text-white' : 'flex-1 py-2 text-xs font-bold rounded-lg bg-gray-200 text-gray-800';
      document.getElementById('tab-chr').className = cat === 'chronic' ? 'flex-1 py-2 text-xs font-bold rounded-lg bg-brand-blue text-white' : 'flex-1 py-2 text-xs font-bold rounded-lg bg-gray-200 text-gray-800';
      renderDiseases();
    }

    // Render Dynamic Disease Cards
    function renderDiseases() {
      const container = document.getElementById('disease-list');
      const searchQuery = document.getElementById('disease-search').value.toLowerCase();
      container.innerHTML = '';

      const filtered = diseases.filter(d => {
        const matchesFilter = (activeFilter === 'all') || (d.category === activeFilter);
        const data = d[currentLang];
        const matchesSearch = data.name.toLowerCase().includes(searchQuery) || data.symptoms.toLowerCase().includes(searchQuery);
        return matchesFilter && matchesSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<p class="text-sm text-gray-500 text-center py-4">No matching symptoms found.</p>`;
        return;
      }

      filtered.forEach(d => {
        const info = d[currentLang];
        const isChronic = !d.isCommunicable;

        const card = document.createElement('div');
        card.className = "border-2 border-gray-200 rounded-xl p-4 bg-gray-50 hover:bg-white transition space-y-2";
        
        card.innerHTML = `
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-base text-brand-blue">${info.name}</h3>
            <span class="text-xs px-2 py-0.5 rounded font-semibold ${isChronic ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800'}">
              ${isChronic ? (currentLang === 'en' ? 'Non-Communicable' : 'தொற்றா நோய்') : (currentLang === 'en' ? 'Communicable' : 'தொற்று நோய்')}
            </span>
          </div>
          <p class="text-xs text-gray-700"><strong><i class="fa-solid fa-stethoscope mr-1"></i>Symptoms:</strong> ${info.symptoms}</p>
          <p class="text-xs text-green-800"><strong><i class="fa-solid fa-house-medical mr-1"></i>Remedies:</strong> ${info.remedies}</p>
          <p class="text-xs text-blue-900"><strong><i class="fa-solid fa-pills mr-1"></i>Suggested OTC Tablets:</strong> ${info.tablets}</p>
          <p class="text-xs text-purple-900"><strong><i class="fa-solid fa-utensils mr-1"></i>Diet Advice:</strong> ${info.diet}</p>
          ${isChronic ? `
            <div class="pt-2">
              <button onclick="scrollToAppointment('${info.name}')" class="w-full bg-amber-600 text-white text-xs py-2 rounded-lg font-bold hover:bg-amber-700 transition flex items-center justify-center space-x-1">
                <i class="fa-solid fa-phone-volume"></i>
                <span>${currentLang === 'en' ? 'Book Phone Consultation with Doctor' : 'மருத்துவ ஆலோசனை பெற பதிவு செய்'}</span>
              </button>
            </div>
          ` : ''}
        `;
        container.appendChild(card);
      });
    }

    // Trigger SOS Call
    function triggerSOS() {
      if (confirm(currentLang === 'en' ? "Call Emergency 108 Ambulance now?" : "108 ஆம்புலன்ஸ் சேவைக்கு அழைக்கவா?")) {
        window.location.href = "tel:108";
      }
    }

    // Save Patient Profile to LocalStorage
    function savePatientInfo(e) {
      e.preventDefault();
      const patient = {
        name: document.getElementById('patient-name').value,
        mobile: document.getElementById('patient-mobile').value,
        aadhar: document.getElementById('patient-aadhar').value
      };
      localStorage.setItem('senior_patient_data', JSON.stringify(patient));
      alert(contentData[currentLang].saveModalSuccess);
    }

    // Load Saved Patient Info
    function loadSavedPatient() {
      const saved = localStorage.getItem('senior_patient_data');
      if (saved) {
        const patient = JSON.parse(saved);
        document.getElementById('patient-name').value = patient.name || '';
        document.getElementById('patient-mobile').value = patient.mobile || '';
        document.getElementById('patient-aadhar').value = patient.aadhar || '';
      }
    }

    // Scroll to Doctor Appointment Section
    function scrollToAppointment(diseaseName) {
      document.getElementById('appoint-reason').value = diseaseName;
      document.getElementById('doctor-heading').scrollIntoView({ behavior: 'smooth' });
    }

    // Book Phone Appointment
    function bookAppointment(e) {
      e.preventDefault();
      const doc = document.getElementById('appoint-doctor').value;
      const date = document.getElementById('appoint-date').value;
      const reason = document.getElementById('appoint-reason').value;

      alert(`${contentData[currentLang].bookModalSuccess}\n\nDoctor: ${doc}\nDate: ${date}\nReason: ${reason}`);
    }

    // Text to Speech Voice Reader for Visually Challenged Seniors
    function speakInstructions() {
      if ('speechSynthesis' in window) {
        const text = currentLang === 'en' 
          ? "Welcome to Senior Care App. For medical emergencies press the top red button to call 108 ambulance immediately. Doctors Satheesh Kumar and Vijayakumari are available for phone consultations."
          : "முதியோர் மருத்துவ உதவி செயலிற்கு நல்வரவு. அவசர தேவைக்கு மேலே உள்ள சிவப்பு நிற பொத்தானை அழுத்தி 108 ஆம்புலன்ஸை அழைக்கலாம்.";
        
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.rate = 0.9; // Slower rate for elderly clarity
        utterance.lang = currentLang === 'en' ? 'en-US' : 'ta-IN';
        window.speechSynthesis.speak(utterance);
      } else {
        alert("Voice synthesis is not supported on this browser.");
      }
    }
  </script>
